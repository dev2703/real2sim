  "equations": {
    "arm_degrees": "d = (reported_encoder_tick - (range_min + range_max)/2) * 360 / 4095",
    "arm_inverse": "reported_encoder_tick = d * 4095 / 360 + (range_min + range_max)/2",
    "feetech_homing": "reported_encoder_tick = physical_encoder_tick - homing_offset; homing pose is set to int(4095/2)=2047",
    "gripper_percent_drive_mode_0": "p = 100 * (clip(reported_encoder_tick,range_min,range_max) - range_min)/(range_max-range_min)",
    "sim_arm_current": "q_sim_rad = deg2rad(d); signs=+1, offsets=0, provisional",
    "sim_arm_identified_form": "q_sim_rad = sign * deg2rad(d) + physical_offset_rad; requires independent poses or registration",
    "physical_joint_from_encoder": "q_phys_rad = sign * (reported_encoder_tick + homing_offset - physical_encoder_zero_tick) * 2*pi/4095; physical_encoder_zero_tick is not stored in calibration",
    "sim_gripper_current": "q_sim_rad = -0.1745 + (p/100)*1.9199"
  },
